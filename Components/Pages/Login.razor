@page "/"

<PageTitle>Sign in · Pulse</PageTitle>

<div class="auth-shell">
    <div class="auth-visual">
        <div class="brand-row"><div class="brand-mark">P</div><span>pulse</span></div>
        <div class="auth-quote"><span>“</span><h1>Good conversations<br /><em>move us forward.</em></h1><p>A calmer, more connected way to keep up with your people.</p></div>
        <div class="auth-art"><span class="art-bubble bubble-one">Hey! How are you?</span><span class="art-bubble bubble-two">Doing great ✦</span><div class="art-orbit"></div></div>
    </div>
    <div class="auth-form-wrap">
        <div class="auth-form">
            <div class="mobile-auth-brand"><div class="brand-mark">P</div><span>pulse</span></div>
            <p class="eyebrow">Welcome back</p>
            <h1>Sign in to Pulse</h1>
            <p class="auth-subtitle">Your conversations are waiting for you.</p>
            <button class="social-button">◎ <span>Continue with Google</span></button>
            <div class="or-divider"><span>or continue with email</span></div>
            <label>Email address<input type="email" placeholder="you@example.com" /></label>
            <div class="form-field"><label for="login-password">Password</label><div class="password-field"><input id="login-password" type="password" placeholder="Enter your password" /><button type="button">Show</button></div></div>
            <div class="form-options"><label class="check-label"><input type="checkbox" /> Remember me</label><a href="/">Forgot password?</a></div>
            <a class="primary-button full-button" href="/messenger">Sign in <span>→</span></a>
            <p class="auth-footer">Don't have an account? <a href="/register">Create one</a></p>
            <p class="demo-note">Demo mode · No account required. <a href="/messenger">Explore Pulse</a></p>
        </div>
    </div>
</div>
